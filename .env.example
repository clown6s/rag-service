# ============================================================
# RAG Service 环境变量模板
# 用法：复制本文件为 .env，填入真实值（生产用强密码，勿用默认值）
# 生成强密码：openssl rand -base64 32
# ============================================================

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 硅基流动 API Key (https://siliconflow.cn/)
# 用于 BGE-M3 Embedding + bge-reranker-v2-m3
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# Milvus 向量数据库
MILVUS_HOST=10.211.55.30
MILVUS_PORT=19530
# Milvus RBAC 鉴权（生产必须开启，留空则无鉴权连接）
MILVUS_USERNAME=
MILVUS_PASSWORD=

# MinIO（Milvus 对象存储后端）— 禁用默认弱密码 minioadmin，用强密码
MINIO_ROOT_USER=minio_admin_user
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Neo4j（可选，启用 graph profile 时需要）— 禁用弱密码 password123
NEO4J_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
